@model HookRelay.Features.Inspector.RequestRow
@using HookRelay.Domain
@using HookRelay.Features.Inspector
<tr data-request-id="@Model.Id">
    <td><span class="badge text-bg-dark method-badge">@Model.Method</span></td>
    <td class="text-nowrap">@Model.ReceivedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
    <td class="text-break">@(Model.Query ?? "—")</td>
    <td>
        <span class="request-status-cell">@await Html.PartialAsync("~/Views/Partials/_DeliveryBadge.cshtml", Model.DeliveryStatus)</span>
        @if (Model.DeliveryStatus == DeliveryStatus.Dead && Model.DeliveryId is not null)
        {
            <button type="button"
                    class="btn btn-sm btn-outline-danger ms-2"
                    hx-post="/deliveries/@Model.DeliveryId.Value/replay"
                    hx-target="closest td"
                    hx-swap="innerHTML">Replay</button>
        }
    </td>
    <td class="text-end">
        <button type="button"
                class="btn btn-sm btn-outline-secondary"
                data-bs-toggle="collapse"
                data-bs-target="#request-detail-@Model.Id"
                aria-expanded="false">
            Details
        </button>
    </td>
</tr>
<tr class="request-detail">
    <td colspan="5">
        <div id="request-detail-@Model.Id" class="collapse">
            <div class="row g-3 pt-2">
                <div class="col-md-5">
                    <h6 class="text-muted">Headers</h6>
                    @{
                        var headers = RequestFormatter.ParseHeaders(Model.Headers);
                    }
                    @if (headers.Count == 0)
                    {
                        <p class="text-muted small mb-0">None.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped mb-0">
                                <tbody>
                                    @foreach (var header in headers)
                                    {
                                        <tr>
                                            <th scope="row" class="text-muted small">@header.Name</th>
                                            <td class="small text-break">@header.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="col-md-7">
                    <h6 class="text-muted">Body</h6>
                    <pre class="request-body"><code class="small">@RequestFormatter.PrettyPrintBody(Model.Body)</code></pre>
                </div>

                <div class="col-12">
                    <h6 class="text-muted">Attempts</h6>
                    @if (Model.Attempts.Count == 0)
                    {
                        <p class="text-muted small mb-0">No attempts yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                        <th>Duration</th>
                                        <th>Error</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Attempts.Count; i++)
                                    {
                                        var attempt = Model.Attempts[i];
                                        <tr>
                                            <td class="small">@(i + 1)</td>
                                            <td class="small text-nowrap">@attempt.AttemptedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td class="small">@(attempt.StatusCode is null ? "—" : attempt.StatusCode.Value.ToString())</td>
                                            <td class="small">@(attempt.DurationMs is null ? "—" : $"{attempt.DurationMs.Value} ms")</td>
                                            <td class="small text-break">@(attempt.Error ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </td>
</tr>