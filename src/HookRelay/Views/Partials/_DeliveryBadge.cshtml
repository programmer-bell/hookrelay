@model string
@using HookRelay.Domain
@switch (Model)
{
    case DeliveryStatus.Pending:
        <span class="status status-pending" data-badge=""><span class="dot"></span>pending</span>
        break;
    case DeliveryStatus.Delivering:
        <span class="status status-delivering" data-badge=""><span class="dot"></span>delivering</span>
        break;
    case DeliveryStatus.Succeeded:
        <span class="status status-succeeded" data-badge=""><span class="dot"></span>succeeded</span>
        break;
    case DeliveryStatus.Dead:
        <span class="status status-dead" data-badge=""><span class="dot"></span>dead</span>
        break;
    default:
        <span class="status status-pending" data-badge=""><span class="dot"></span>@Model</span>
        break;
}