@page
@model HookRelay.Views.Pages.IndexModel
@{
    ViewData["Title"] = "HookRelay";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HookRelay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <main class="container py-4">
        <header class="mb-4">
            <h1>HookRelay</h1>
            <p class="text-muted mb-0">Create a capture URL, send webhooks to it, and forward them anywhere.</p>
        </header>

        <div id="endpoint-form">
            @await Html.PartialAsync("~/Views/Partials/_EndpointForm.cshtml", (object?)null)
        </div>

        <div class="mt-4" id="endpoint-list">
            @await Html.PartialAsync("~/Views/Partials/_EndpointList.cshtml", Model.Endpoints)
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/htmx.min.js"></script>
</body>
</html>