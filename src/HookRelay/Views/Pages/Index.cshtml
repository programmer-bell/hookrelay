@page
@model HookRelay.Views.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="container section">
    <header class="hero reveal">
        <div class="chip">
            <span class="status-dot ok" id="system-dot"></span>
            <span id="system-status">Checking systems…</span>
            <small>· free tier</small>
        </div>
        <h1>Webhooks, relayed reliably.</h1>
        <p class="lead">Create a capture URL, send webhooks to it, and watch HookRelay forward them — with retries, signatures, and a dead-letter queue you can replay.</p>
    </header>

    <div id="endpoint-form" class="reveal">
        @await Html.PartialAsync("~/Views/Partials/_EndpointForm.cshtml", (object?)null)
    </div>

    <div id="endpoint-list" style="margin-top: 22px;">
        @await Html.PartialAsync("~/Views/Partials/_EndpointList.cshtml", Model.Endpoints)
    </div>
</div>