@{
    var pageTitle = ViewData["Title"] as string ?? "HookRelay";
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle · HookRelay</title>
    <link rel="icon" type="image/jpeg" href="/icon.jpg" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content="Create a capture URL, send webhooks to it, and forward them anywhere — with retries, signatures, and a dead-letter queue." />
    <link rel="stylesheet" href="/css/site.css?v=8" />
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('hr-theme');
                var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {}
        })();
    </script>
</head>
<body>
    <nav class="nav" aria-label="Main">
        <div class="nav-inner">
            <a class="brand" href="/" aria-label="HookRelay home">
                <img src="/icon.jpg" alt="" width="26" height="26" />
                <span class="brand-name">HookRelay</span>
            </a>
            <div class="nav-links">
                <a class="nav-link text" href="/">Endpoints</a>
                <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle color theme">
                    <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
                    <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </button>
            </div>
        </div>
    </nav>

    @RenderBody()

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script src="/js/htmx.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="/js/site.js?v=8"></script>
</body>
</html>