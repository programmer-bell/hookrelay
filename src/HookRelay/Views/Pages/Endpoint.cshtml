@page "/endpoints/{slug}"
@model HookRelay.Views.Pages.EndpointModel
@{ ViewData["Title"] = Model.Endpoint is null ? "Endpoint" : $"Endpoint: {Model.Endpoint.Name}"; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · HookRelay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <main class="container py-4">
        <nav class="mb-3">
            <a href="/" class="link-secondary">&larr; All endpoints</a>
        </nav>

        @if (Model.Endpoint is null)
        {
            <div class="alert alert-warning">Endpoint not found.</div>
        }
        else
        {
            <header class="mb-4">
                <h1>@Model.Endpoint.Name</h1>
                <p class="text-muted mb-1">Create this endpoint at <a href="@Model.Endpoint.TargetUrl" target="_blank" rel="noopener">@Model.Endpoint.TargetUrl</a>. Created
                    @Model.Endpoint.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm").</p>
                <div class="input-group input-group-sm w-50">
                    <input id="ingest-url" type="text" class="form-control" value="@Model.IngestUrl" readonly aria-label="Ingest URL" />
                    <button type="button" id="copy-button" class="btn btn-outline-secondary">Copy</button>
                </div>
            </header>

            <section>
                <h2 class="h5 mb-2">Recent requests</h2>
                <ul class="nav nav-pills mb-3" id="status-tabs">
                    @foreach (var tab in new[]
                             {
                                 ("all", "All"),
                                 ("pending", "Pending"),
                                 ("succeeded", "Succeeded"),
                                 ("dead", "Dead"),
                             })
                    {
                        var isActive = string.Equals(Model.CurrentFilter, tab.Item1, StringComparison.Ordinal);
                        <li class="nav-item">
                            <a class="nav-link py-1 px-2 @(isActive ? "active" : "")"
                               href="@($"/endpoints/{Model.Endpoint.Slug}?status={tab.Item1}")"
                               hx-get="@($"/endpoints/{Model.Endpoint.Slug}/rows?status={tab.Item1}")"
                               hx-target="#request-rows"
                               hx-swap="innerHTML">@tab.Item2</a>
                        </li>
                    }
                </ul>
                <div id="live-feed" hx-ext="sse"@(Model.StreamEnabled ? $" sse-connect=\"{Model.StreamUrl}\"" : string.Empty)>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Method</th>
                                    <th>Received</th>
                                    <th>Query</th>
                                    <th>Delivery</th>
                                    <th class="text-end">Details</th>
                                </tr>
                            </thead>
                            <tbody id="request-rows"
                                   sse-swap="request-row"
                                   hx-swap="afterbegin">
                                @await Html.PartialAsync("~/Views/Partials/_RequestRows.cshtml", Model.Requests)
                            </tbody>
                        </table>
                    </div>
                    <span id="delivery-status-target" class="d-none" sse-swap="delivery-status"></span>
                </div>
            </section>
        }
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/htmx.min.js"></script>
    <script src="/js/htmx-ext-sse.js"></script>
    <script>
        document.getElementById('copy-button')?.addEventListener('click', function () {
            navigator.clipboard.writeText(document.getElementById('ingest-url').value).then(function () {
                var button = document.getElementById('copy-button');
                button.textContent = 'Copied';
                setTimeout(function () { button.textContent = 'Copy'; }, 1500);
            }).catch(function () {
                document.getElementById('ingest-url').select();
            });
        });

        var requestRows = document.getElementById('request-rows');
        document.body.addEventListener('htmx:sseMessage', function (event) {
            var detail = event.detail;
            if (!detail || !detail.data) return;

            if (detail.type === 'delivery-status') {
                var parsed = document.createElement('div');
                parsed.innerHTML = detail.data;
                var wrapper = parsed.querySelector('span[data-request-id]');
                if (!wrapper) return;
                var row = requestRows.querySelector('tr[data-request-id="' + wrapper.getAttribute('data-request-id') + '"]');
                if (!row) return;
                var badge = wrapper.querySelector('.badge');
                var statusCell = row.querySelector('.request-status-cell');
                if (badge && statusCell) { statusCell.innerHTML = badge.outerHTML; }
                return;
            }

            if (detail.type !== 'request-row') return;
            var seen = new Set();
            requestRows.querySelectorAll('tr[data-request-id]').forEach(function (row) {
                var id = row.getAttribute('data-request-id');
                if (seen.has(id)) { row.remove(); } else { seen.add(id); }
            });
            while (requestRows.querySelectorAll('tr').length > 50) {
                requestRows.removeChild(requestRows.lastElementChild);
            }
        });
    </script>
</body>
</html>