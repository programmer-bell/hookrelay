@page "/endpoints/{slug}"
@model HookRelay.Views.Pages.EndpointModel
@{
    ViewData["Title"] = Model.Endpoint is null ? "Endpoint" : Model.Endpoint.Name;
}
<div class="container section">
    @if (Model.Endpoint is null)
    {
        <div class="panel panel-pad" style="max-width: 480px; margin: 8vh auto;">
            <div class="empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/></svg>
                <p class="empty-title">Endpoint not found</p>
                <p class="empty-sub">It may have been deleted.</p>
                <a class="btn btn-ghost" href="/" style="margin-top: 12px;">&larr; All endpoints</a>
            </div>
        </div>
    }
    else
    {
        <div class="reveal">
            <a class="nav-link" href="/" style="padding-left: 0; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-7-7 7 7 7"/></svg>
                All endpoints
            </a>
        </div>

        <header class="hero reveal">
            <div class="chip" style="text-transform: none;">
                <span class="status-dot ok"></span>
                Event endpoint
                <small>· created @Model.Endpoint.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</small>
            </div>
            <h1>@Model.Endpoint.Name</h1>
            <p class="lead">Forwards to <a href="@Model.Endpoint.TargetUrl" target="_blank" rel="noopener">@Model.Endpoint.TargetUrl</a></p>

            <div class="copy-group" style="margin-top: 8px; max-width: 640px;">
                <div class="copy-inputs">
                    <input id="ingest-url" class="input mono" type="text" value="@Model.IngestUrl" readonly aria-label="Ingest URL" />
                    <button type="button" class="copy-mini icon-btn" data-copy="#ingest-url" aria-label="Copy ingest URL" title="Copy ingest URL">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                    </button>
                </div>
                <button type="button" class="btn" data-copy="#ingest-url">Copy</button>
            </div>
        </header>

        <section class="panel reveal">
            <div class="panel-header">
                <h2>Recent requests</h2>
                <div class="tabs" id="status-tabs" role="tablist" aria-label="Filter requests">
                    @foreach (var tab in new[]
                             {
                                 ("all", "All", "all"),
                                 ("pending", "Pending", "pending"),
                                 ("succeeded", "Succeeded", "succeeded"),
                                 ("dead", "Dead", "dead"),
                             })
                    {
                        var isActive = string.Equals(Model.CurrentFilter, tab.Item1, StringComparison.Ordinal);
                        <a class="tab @(isActive ? "active" : "")"
                           role="tab"
                           aria-selected="@(isActive ? "true" : "false")"
                           href="@($"/endpoints/{Model.Endpoint.Slug}?status={tab.Item1}")"
                           hx-get="@($"/endpoints/{Model.Endpoint.Slug}/rows?status={tab.Item1}")"
                           hx-target="#request-rows"
                           hx-swap="innerHTML">@tab.Item2</a>
                    }
                </div>
            </div>

            <div id="live-feed" hx-ext="sse" @(Model.StreamEnabled ? $"sse-connect=\"{Model.StreamUrl}\"" : string.Empty)>
                <div class="table-wrap">
                    <table class="table hover">
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Received</th>
                                <th class="hide-sm">Query</th>
                                <th>Delivery</th>
                                <th class="text-right" style="text-align: right;">Details</th>
                            </tr>
                        </thead>
                        <tbody id="request-rows" sse-swap="request-row" hx-swap="afterbegin">
                            @await Html.PartialAsync("~/Views/Partials/_RequestRows.cshtml", Model.Requests)
                        </tbody>
                    </table>
                </div>
                <span id="delivery-status-target" class="hidden" sse-swap="delivery-status"></span>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script src="/js/htmx-ext-sse.js"></script>
}