# Local dev uses the compose Postgres. For Neon, paste your connection string:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Server binding. Render injects $PORT; local default is port 8080.
ASPNETCORE_URLS=http://+:8080

# ASP.NET environment (Development / Production)
ASPNETCORE_ENVIRONMENT=Development

# Delivery worker settings (defaults; overridable per deployment)
Delivery__MaxAttempts=6
Delivery__TimeoutSeconds=10
Delivery__PollIntervalSeconds=2